# ----------------------------------------------------------------------
# Mom's Cloud Kitchen - environment variables
# Copy this file to .env.local (or .env) and fill in as needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ----------------------------------------------------------------------

# Meta (Facebook) Ads Pixel ID.
# Optional: if omitted or empty, the Meta Pixel is not initialized and the
# site continues to work normally (form leads still fall back to WhatsApp).
VITE_META_PIXEL_ID=
